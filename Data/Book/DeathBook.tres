book_id = "DeathBook"
pages = Array[Dictionary]([{
"text": "Trong trường hợp bạn bị mắc kẹt hoặc rơi vào một cái hố vô tận? Bạn có thể reset bản thân bằng cách bấm vào nút góc trái dưới."
}, {
"text": "Phía trước bạn là gai. Bạn sẽ chết nếu bạn chạm phải nó, tất nhiên rồi."
}, {
"text": "Trong game này, Blue Guy chạm cái gì nguy hiểm là ‘tèo’. Nên cẩn thận nha."
}])
