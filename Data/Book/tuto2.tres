pages = Array[Dictionary]([{
"text": "Mục tiêu trong game này là thu thập các Solra (cậu trai tóc vàng kia và các bản thể khác của cậu ta), cũng như các Cameo (các nhân vật khác xuất hiện trong tòa tháp)."
}, {
"text": "Nhấn vào Solrapedia để xem danh sách các Solra và Cameo"
}, {
"text": "Các Solra và Cameo chưa được thu thập sẽ bị ẩn"
}, {
"text": "Giờ hãy thu thập Solra bằng cách chạm vào Solra."
}])
