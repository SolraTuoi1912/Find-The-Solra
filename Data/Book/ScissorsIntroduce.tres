pages = Array[Dictionary]([{
"text": "Chào mừng tới với parkour tân thủ!\\n\\nChà, thử thách cậu đó, Blue Guy. Nói thử xem nhảy qua 9 cái gai kia, rồi sau đó bọn kéo truy đuổi cậu tới chết, không biết cậu sẽ chết bao lần nhỉ?"
}, {
"image": "res://Sprites/BookArt/HasamiSign.png",
"text": "Tôi chờ ông anh quản gia của tôi báo xem cậu chết bao lần, heh.\\n\\nKí tên\\nHasami Jidou"
}])
